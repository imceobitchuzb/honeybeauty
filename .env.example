# -----------------------------------------------------------------------------
# FLUTTERHONEY BUSINESS & COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Authentication & Session Security
# Generate a strong 32+ character random string for production cookie encryption
SESSION_SECRET="flutterhoney-luxury-secret-key-change-in-production-min32chars"

# Database Configuration (Optional external PostgreSQL URL)
# If omitted, application uses the built-in encrypted local file database storage
DATABASE_URL=""

# Square Integration (Official Square APIs)
# Get credentials from https://developer.squareup.com/apps
SQUARE_ENVIRONMENT="sandbox" # Options: sandbox | production
SQUARE_APPLICATION_ID="sandbox-sq0idb-your-application-id"
SQUARE_ACCESS_TOKEN="EAAAyour-square-access-token"
SQUARE_LOCATION_ID="your-square-location-id"
SQUARE_WEBHOOK_SIGNATURE_KEY="your-webhook-signature-key"

# Business Information
NEXT_PUBLIC_BUSINESS_NAME="Flutterhoney"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_OFFICIAL_BOOKING_URL="https://flutterhoney-lash.square.site/"

# Notifications (Optional email delivery, e.g., Resend or Sendgrid)
# Leave empty until authorized credentials are provided
NOTIFICATION_PROVIDER=""
NOTIFICATION_API_KEY=""
NOTIFICATION_FROM_EMAIL="appointments@flutterhoney.com"
